# ==============================================================================
# CONVERSAGT OMNICHANNEL AI CRM - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Versión: 3.2.0-Production-Hardened
# ==============================================================================
# IMPORTANTE: Copie este archivo a '.env' y configure los valores correspondientes.
# NUNCA suba su archivo '.env' con valores reales a repositorios públicos de Git.

# ------------------------------------------------------------------------------
# 1. CORE & INFRAESTRUCTURA (OBLIGATORIAS)
# ------------------------------------------------------------------------------
# Entorno de ejecución: 'development' o 'production'
NODE_ENV="production"

# Puerto en el que corre el servidor backend (En contenedor Cloud Run es 3000)
PORT=3000

# URL canónica de la aplicación (Inyectada automáticamente en Google Cloud Run)
APP_URL="https://conversagt.ingenieroai.pro"

# ------------------------------------------------------------------------------
# 2. INTELIGENCIA ARTIFICIAL GOOGLE GEMINI (OBLIGATORIA PARA IA)
# ------------------------------------------------------------------------------
# Clave de API de Google AI Studio / Gemini API.
# Obténgala en: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN, SESIONES CRIPTOGRÁFICAS Y SUPER ADMIN (SECRETOS CRÍTICOS)
# ------------------------------------------------------------------------------
# Clave secreta para firmar cookies de sesión y tokens anti-tampering (Mínimo 32 caracteres aleatorios)
# Generar con: openssl rand -base64 32
SESSION_SECRET="conversagt-enterprise-production-scrypt-secret-key-change-me-in-production-2026"

# Correo del Super Administrador inicial (Ingeniero AI)
ADMIN_DEFAULT_EMAIL="andersonwiliam637@gmail.com"

# Contraseña inicial del Super Administrador (Se almacena hasheada con Scrypt)
ADMIN_DEFAULT_PASSWORD="CAMBIAR_POR_CONTRASENA_SEGURA_2026!"

# PIN secreto del Administrador para acceso de emergencia / consola técnica
ADMIN_SECRET_PIN="CAMBIAR_POR_PIN_SEGURO_6_DIGITOS"

# ------------------------------------------------------------------------------
# 4. CANAL WHATSAPP META CLOUD API & WEBHOOKS (INTEGRACIÓN EXTERNA)
# ------------------------------------------------------------------------------
# Token secreto de verificación para el handshake GET de Meta Webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN="CAMBIAR_POR_TOKEN_ALEATORIO_META_VERIFY"

# Secreto de la aplicación Meta (App Secret) usado para validar la firma HMAC SHA-256 en X-Hub-Signature-256
WHATSAPP_APP_SECRET="CAMBIAR_POR_APP_SECRET_DE_META_DEVELOPERS"

# ID del número telefónico de WhatsApp Business registrado en Meta
WHATSAPP_PHONE_ID="109482019482019"

# Token de Acceso Permanente (System User Token) de Meta Business Manager
WHATSAPP_ACCESS_TOKEN="EAA..."

# ------------------------------------------------------------------------------
# 5. CANAL TELEGRAM BOT (INTEGRACIÓN EXTERNA)
# ------------------------------------------------------------------------------
# Token provisto por @BotFather en Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Secreto opcional para validar webhooks de Telegram en el header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET="telegram-webhook-secret-token"

# ------------------------------------------------------------------------------
# 6. FACTURACIÓN ELECTRÓNICA GUATEMALA SAT DTE / FEL (INTEGRACIÓN EXTERNA)
# ------------------------------------------------------------------------------
# Certificador DTE autorizado (ej. 'INFILE', 'GUATEFACTURAS', 'DIGIFACT', 'MEGAPRINT')
# Estado actual: PENDIENTE DE CREDENCIALES DE CERTIFICADOR OFICIAL
SAT_FEL_CERTIFICADOR="GUATEFACTURAS"
SAT_FEL_NIT_EMISOR="12345678-9"
SAT_FEL_API_KEY="CAMBIAR_POR_API_KEY_CERTIFICADOR"
SAT_FEL_ESTABLECIMIENTO="1"

# ------------------------------------------------------------------------------
# 7. BASE DE DATOS Y MULTI-TENANCY
# ------------------------------------------------------------------------------
# Ruta del archivo SQLite relacional centralizado (con soporte WAL mode)
DATABASE_FILE="./data/conversagt.db"

# ------------------------------------------------------------------------------
# 8. PASARELA DE PAGO PAYPAL (WEBHOOKS & CHECKOUT API)
# ------------------------------------------------------------------------------
# ID de cliente de la aplicación PayPal Developer (Sandbox o Live)
PAYPAL_CLIENT_ID="CAMBIAR_POR_PAYPAL_CLIENT_ID"

# Secreto de cliente de PayPal Developer
PAYPAL_CLIENT_SECRET="CAMBIAR_POR_PAYPAL_CLIENT_SECRET"

# ID del Webhook registrado en PayPal Developer (ej. 6VT269952U654131N)
PAYPAL_WEBHOOK_ID="6VT269952U654131N"

# Modo de ejecución de PayPal: 'sandbox' o 'live'
PAYPAL_ENVIRONMENT="sandbox"
